{
  "window": {
    "type": "sdl2",
    "scale": 2,
    "color_palette": "grayscale",
    "fullscreen": false
  },
  "sound": {
    "enabled": true,
    "volume": 50,
    "sample_rate": 44100,
    "buffer_size": 1024,
    "emulated": true
  },
  "performance": {
    "frame_skip": 0,
    "target_fps": 60,
    "enable_vsync": true
  },
  "process": {
    "startup_timeout": 10,
    "shutdown_timeout": 5,
    "auto_restart": true,
    "cleanup_on_exit": true
  },
  "debug": {
    "log_level": "INFO",
    "show_fps": false,
    "enable_debug_overlay": false
  }
}